# Copy to .env (git-ignored) and fill in. Vite only exposes VITE_* vars to the browser.
# Firebase web config: Firebase console → project exammaster-50309 → Project settings
# → Your apps → Web app → SDK setup and configuration → Config.
# The same names must exist as GitHub repository variables for the deploy workflow.
VITE_API_BASE_URL=https://exam-master-backend.onrender.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=exammaster-50309.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=exammaster-50309
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=1080763109705
VITE_FIREBASE_APP_ID=
